# App database (local Postgres 16, or a Neon connection string in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_dev
# Integration tests only; never point this at invoice_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_test
# Playwright e2e only (its own database, so `npm run test` and `npm run e2e` never collide)
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_e2e
# Better Auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Public base URL of the app, used for links that leave it (share link, email). Optional: falls back to BETTER_AUTH_URL, then the request host
APP_URL=
# Vercel Blob token for logo / payment-proof uploads. Optional: without it files are stored on local disk under public/uploads/
BLOB_READ_WRITE_TOKEN=
# PDF: the server signs the print URL that headless Chromium opens (generate with: openssl rand -base64 32)
PRINT_SECRET=change-me-to-another-long-random-string
# PDF (local only): path of a Chromium/Chrome binary. On Vercel @sparticuz/chromium is used and this is ignored
CHROMIUM_PATH=
