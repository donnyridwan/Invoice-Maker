# App database (local Postgres 16, or a Neon connection string in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_dev
# Optional: direct (non-pooled) connection used by drizzle-kit migrations (e.g. Neon without -pooler).
DATABASE_URL_UNPOOLED=
# Integration tests only; never point this at invoice_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_test
# Playwright e2e only (its own database, so `npm run test` and `npm run e2e` never collide)
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_e2e
# Better Auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Public base URL of the app, used for links that leave it (share link, email, PDF). Optional locally: falls back to BETTER_AUTH_URL, then the request host.
# Set it in production (Vercel): it is the origin the PDF renderer opens. Previews use their own VERCEL_BRANCH_URL / VERCEL_URL instead.
APP_URL=
# Vercel Blob token for logo / payment-proof uploads. Optional: without it files are stored on local disk under public/uploads/
BLOB_READ_WRITE_TOKEN=
# PDF: the server signs the print URL that headless Chromium opens (generate with: openssl rand -base64 32)
PRINT_SECRET=change-me-to-another-long-random-string
# PDF (local only): path of a Chromium/Chrome binary. On Vercel @sparticuz/chromium is used and this is ignored
CHROMIUM_PATH=
# PDF on Vercel: when Deployment Protection is on, set this to the project's "Protection Bypass for Automation" secret so the renderer can open its own print page
VERCEL_AUTOMATION_BYPASS_SECRET=
# Email (invoices, verification, payment notifications) through Resend. Both are required to enable email; without them the app hides email options
RESEND_API_KEY=
# Domain verified in Resend; mail goes out as "<Business name>" <invoice@EMAIL_FROM_DOMAIN>
EMAIL_FROM_DOMAIN=
# Set to "file" to write emails to var/outbox/*.json instead of sending (local development and e2e). Ignored (email disabled) on any production build and on Vercel production; the e2e server, a production build, also sets ALLOW_FILE_EMAIL_TRANSPORT=true
EMAIL_TRANSPORT=
# Cron: Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*; requests without it get 401 (generate with: openssl rand -base64 32)
CRON_SECRET=change-me-to-yet-another-long-random-string
